{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"formatter": {
		"enabled": true,
		"indentStyle": "space",
		"indentWidth": 2,
		"lineWidth": 100
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"trailingCommas": "all",
			"jsxQuoteStyle": "double",
			"semicolons": "always"
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"suspicious": {
				"noExplicitAny": "warn"
			}
		}
	},
	"assist": { "actions": { "source": { "organizeImports": "off" } } },
	"files": {
		"includes": [
			"**/*.ts",
			"**/*.tsx",
			"!**/node_modules/**",
			"!**/dist/**",
			"!**/.turbo/**",
			"!**/coverage/**",
			"!**/.next/**"
		]
	}
}
